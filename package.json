{
  "name": "magpie-doubao-translate",
  "version": "0.1.2",
  "description": "Doubao web translation provider for Magpie and OpenCode",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./server": "./dist/index.mjs"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "node --test tests/",
    "test:watch": "node --test --watch tests/",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "files": [
    "dist/index.mjs",
    "assets/icon-magpie.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mu-zi-lee/magpie-doubao-translate.git"
  },
  "homepage": "https://github.com/mu-zi-lee/magpie-doubao-translate#readme",
  "bugs": {
    "url": "https://github.com/mu-zi-lee/magpie-doubao-translate/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "doubao",
    "translation"
  ],
  "license": "MIT",
  "magpie": {
    "icon": "https://raw.githubusercontent.com/mu-zi-lee/magpie-doubao-translate/v0.1.2/assets/icon-magpie.png",
    "maxConcurrency": 4
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
